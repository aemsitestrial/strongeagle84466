{
  "definitions": [
    {
      "title": "Cards V1",
      "id": "cards-v1",
      "plugins": {
        "da": {
          "rows": 3,
          "columns": 1,
          "fields": [
            {
              "name": "sectionTitle",
              "selector": "div:nth-child(1)>div"
            },
            {
              "name": "classes",
              "selector": "div:nth-child(2)>div>ul"
            },
            {
              "name": "cards",
              "selector": "div:nth-child(3)>div"
            }
          ]
        },
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Cards V1",
              "model": "cards-v1",
              "sectionTitle": "Intelligence at work",
              "classes": [
                "light"
              ],
              "cards": []
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards-v1",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "sectionTitle",
          "label": "Section Title",
          "description": "Heading displayed above the cards grid."
        },
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Style",
          "valueType": "string",
          "required": true,
          "maxSize": 10,
          "options": [
            {
              "name": "Theme",
              "children": [
                {
                  "name": "Light",
                  "value": "light"
                },
                {
                  "name": "Dark",
                  "value": "dark"
                }
              ]
            }
          ]
        },
        {
          "component": "container",
          "name": "cards",
          "label": "Cards",
          "multi": true,
          "fields": [
            {
              "component": "reference",
              "valueType": "string",
              "name": "fileReference",
              "label": "Image",
              "description": "Select the card image."
            },
            {
              "component": "text",
              "valueType": "string",
              "name": "fileReferenceAlt",
              "label": "Image Description",
              "description": "Alternative text used for accessibility."
            },
            {
              "component": "select",
              "valueType": "string",
              "name": "imageRatio",
              "label": "Image Ratio",
              "value": "ratio-16-9",
              "options": [
                {
                  "name": "1:1",
                  "value": "ratio-1-1"
                },
                {
                  "name": "16:9",
                  "value": "ratio-16-9"
                }
              ]
            },
            {
              "component": "text",
              "valueType": "string",
              "name": "primaryTag",
              "label": "Primary Tag",
              "description": "Primary metadata tag displayed above the title."
            },
            {
              "component": "text",
              "valueType": "string",
              "name": "secondaryTag",
              "label": "Secondary Tag",
              "description": "Secondary metadata tag displayed above the title."
            },
            {
              "component": "text",
              "valueType": "string",
              "name": "readTime",
              "label": "Read Time",
              "description": "Optional read time text, for example: 14 min read."
            },
            {
              "component": "text",
              "valueType": "string",
              "name": "overline",
              "label": "Overline",
              "description": "Optional label displayed above the card title."
            },
            {
              "component": "text",
              "valueType": "string",
              "name": "title",
              "label": "Title",
              "description": "Main card heading."
            },
            {
              "component": "richtext",
              "valueType": "string",
              "name": "description",
              "label": "Description",
              "description": "Optional supporting text displayed below the title."
            },
            {
              "component": "text",
              "valueType": "string",
              "name": "ctaLabel",
              "label": "CTA Label",
              "description": "Text displayed for the call-to-action link."
            },
            {
              "component": "text",
              "valueType": "string",
              "name": "ctaLink",
              "label": "CTA Link",
              "description": "Destination URL for the call-to-action."
            }
          ]
        }
      ]
    }
  ],
  "filters": []
}
